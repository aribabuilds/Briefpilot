APP_NAME=BriefPilot
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
STUB_PROCESSING_DELAY_SECONDS=1.5

# Document ingestion / OCR
OCR_LANGUAGE=deu+eng
OCR_RENDER_SCALE=3.0
MAX_DOCUMENT_PAGES=20
OCR_TIMEOUT_SECONDS=30.0
OCR_WORKER_THREADS=2
MIN_MEAN_CONFIDENCE=0.5
MIN_WORD_COUNT=5

# Preprocessing
PREPROCESS_ENABLED=true
DESKEW_MAX_ANGLE=15.0
PREPROCESS_MAX_DIMENSION=3000

DATABASE_URL=postgresql://briefpilot:briefpilot@localhost:5432/briefpilot

# AI provider abstraction — set AI_PROVIDER to select the adapter used by
# app.services.ai.get_ai_service(). Only the selected provider's vars are required.
# Default is "gemini": the zero-cost mandate (CLAUDE.md §3) means the free
# tier is the default, not an opt-in. Get a free key (no billing account
# needed) at https://aistudio.google.com/apikey.
AI_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
