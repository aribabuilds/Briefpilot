APP_NAME=BriefPilot
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_BYTES=10485760
STUB_PROCESSING_DELAY_SECONDS=1.5

# Document ingestion / OCR
OCR_LANGUAGE=deu+eng
OCR_RENDER_SCALE=3.0
MAX_DOCUMENT_PAGES=20

DATABASE_URL=postgresql://briefpilot:briefpilot@localhost:5432/briefpilot

# AI provider abstraction — set AI_PROVIDER to select the adapter used by
# app.services.ai.get_ai_service(). Only the selected provider's vars are required.
AI_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
