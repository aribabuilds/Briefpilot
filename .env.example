# Used by root docker-compose.yml for variable substitution.
# Copy to `.env` before running `docker compose up`.

POSTGRES_USER=briefpilot
POSTGRES_PASSWORD=briefpilot
POSTGRES_DB=briefpilot
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000

# AI provider abstraction (see backend/.env.example for details)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
